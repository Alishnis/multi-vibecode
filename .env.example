# Copy this file to .env and paste your key after the equals sign.
# .env is never committed to git.
OPENROUTER_API_KEY=

# Optional: which model checks decisions for conflicts (an OpenRouter model name).
# CONTRACT_CHECK_MODEL=anthropic/claude-haiku-5.5

# Optional: one password that is accepted in every room for human-only actions
# (answering requests, settling conflicts, retiring decisions). Each room can
# also set its own team key on the dashboard, so this can stay empty.
# CONTRACT_APPROVAL_TOKEN=

# Optional: where the database file is stored (default: server/contract.db).
# CONTRACT_DB_PATH=

# Optional: the most AI checks the whole server runs per minute (default 60).
# CONTRACT_MAX_CHECKS_PER_MINUTE=60
